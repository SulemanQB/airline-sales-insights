	partition fact_booking = m
		mode: import
		source =
				let
				    Source = Parquet.Document(File.Contents(DataFolder & "fact_booking.parquet")),
				    Typed = Table.TransformColumnTypes(Source, {{"booking_id", Int64.Type}, {"booking_date_key", Int64.Type}, {"travel_date_key", Int64.Type}, {"route_key", Int64.Type}, {"channel_key", Int64.Type}, {"fare_key", Int64.Type}, {"pos_key", Int64.Type}, {"segment_key", Int64.Type}, {"lead_time_days", Int64.Type}, {"pax", Int64.Type}, {"status", type text}, {"fare_revenue", Currency.Type}, {"ancillary_revenue", Currency.Type}, {"refund_amount", Currency.Type}, {"distribution_cost", Currency.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

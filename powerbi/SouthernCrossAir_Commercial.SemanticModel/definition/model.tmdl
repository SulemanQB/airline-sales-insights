model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-AU
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","dim_date","dim_route","dim_channel","dim_fare","dim_pos","dim_segment","fact_booking","fact_target","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_date
ref table dim_route
ref table dim_channel
ref table dim_fare
ref table dim_pos
ref table dim_segment
ref table fact_booking
ref table fact_target
ref table _Measures
